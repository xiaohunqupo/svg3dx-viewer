{
  "name": "svg3dx-viewer",
  "version": "0.1.1",
  "description": "svg3dx 查看器组件 — embeddable three.js viewer with editable external params",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-MulanPSL-2.0"
  ],
  "scripts": {
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -p tsconfig.json",
    "build:lib": "tsc -p tsconfig.json",
    "build:embed": "vite build --config examples/embed/vite.config.ts",
    "dev": "npm run build:wasm && vite --config examples/embed/vite.config.ts",
    "preview": "vite preview --config examples/embed/vite.config.ts",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "svg3dx-ffi-wasm": "^0.1.2",
    "three-bvh-csg": "^0.0.16"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-wasm": "^3.3.0"
  },
  "keywords": [
    "svg3dx",
    "svg",
    "3d",
    "three.js",
    "viewer",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohunqupo/svg3dx-viewer.git"
  },
  "homepage": "https://github.com/xiaohunqupo/svg3dx-viewer",
  "bugs": {
    "url": "https://github.com/xiaohunqupo/svg3dx-viewer/issues"
  },
  "license": "MIT OR MulanPSL-2.0"
}
